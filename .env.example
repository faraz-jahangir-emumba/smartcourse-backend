# Copy this file to .env and adjust if needed.
#
# .env is gitignored and holds real values. This file is committed and shows
# anyone cloning the repo which variables exist.
#
# These defaults match compose.yml, so copying it unchanged works locally.

# --- postgres ---
# Host is localhost because the app runs on the machine and only the database
# is in Docker. When the app itself moves into a container, this becomes the
# service name: postgres
POSTGRES_USER=smartcourse
POSTGRES_PASSWORD=smartcourse
POSTGRES_DB=smartcourse
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- environment ---
# local, staging or production. Only "local" may run with the insecure
# defaults below - anything else refuses to start until JWT_SECRET is set.
ENVIRONMENT=local

# Log every SQL statement, including bound parameters. Those include emails
# and password hashes, so keep this off outside your own machine.
DB_ECHO=false

# --- chunking ---
# How publishing cuts lessons into retrievable pieces. A ceiling, not a
# target - content that already fits is left alone. Both are starting points
# and get tuned in Module 4 against real retrieval.
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

# --- the first admin ---
# Read by `python -m smartcourse.seed`, which runs on every `docker compose
# up`. Admin cannot be self-assigned and no endpoint grants it, so this is
# the only way an admin account comes into existence.
#
# Left empty on purpose. Empty means "no admin", and the seed says so and
# exits cleanly. Set both or neither - setting one is treated as a typo and
# fails.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- security ---
# Every token is signed with this. Anyone holding it can mint a token for any
# user, so a real deployment sets its own and never commits it.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Must be at least 32 bytes for HS256.
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-any-real-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
